meta {
  name: Login administrador
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "usuario": "admin",
    "contrasena": "admin123"
  }
}

script:post-response {
  bru.setEnvVar("token", res.body.token);
}

docs {
  Guarda el token en la variable de entorno `token` para el resto de la colección.
  Usuarios demo:
  - admin / admin123
  - operador / operador123
  - auditor / auditor123
}
