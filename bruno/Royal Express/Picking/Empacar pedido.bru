meta {
  name: Empacar pedido
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/api/picking/pedidos/{{pedidoId}}/empacar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Requiere que todas las tareas del pedido estén PICKEADAS.
  El pedido 15 de la semilla es el caso demo.
}
